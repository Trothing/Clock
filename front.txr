src/
├── api/
│   ├── axios.ts               # інстанс axios з інтерсептором JWT
│   ├── auth.api.ts            # login, register — REST-виклики
│   ├── chats.api.ts           # отримати список чатів
│   └── messages.api.ts        # отримати історію (пагінація)
│
├── socket/
│   ├── socket.client.ts       # ініціалізація socket.io-client, конект з токеном
│   └── socket.listeners.ts    # підписка на події ("message:new" тощо), кладе дані в store
│
├── store/
│   ├── auth.store.ts          # zustand: currentUser, token, login/logout
│   ├── chats.store.ts         # zustand: список чатів, активний чат
│   └── messages.store.ts      # zustand: повідомлення по chatId, додавання нового
│
├── features/
│   ├── auth/
│   │   ├── LoginForm.tsx
│   │   └── RegisterForm.tsx
│   ├── chats/
│   │   ├── ChatList.tsx
│   │   └── ChatListItem.tsx
│   └── messages/
│       ├── MessageList.tsx
│       ├── MessageInput.tsx
│       └── MessageBubble.tsx
│
├── pages/
│   ├── LoginPage.tsx
│   └── ChatPage.tsx
│
├── App.tsx                    # роутинг (react-router)
└── main.tsx